@startuml GridSystem

class Grid {
    - rows : int
    - columns : int
    - cellWidth : float
    - cellHeight : float
    - origin : Vector3
    - rotation : Quaternion
    - cells : Cell[,]
    - pathfindingAlgorithm : PathfindingAlgorithm

    + CreateGrid(rows, columns, cellWidth, cellHeight, origin, rotation) : void
    + ResizeGrid (newRows, newColumns) : void
    + MoveGrid(newOrigin) : void
    + SaveToFile(filePath) : void
    + LoadFromFile(filePath) : void
    + FindPath(startPosition, endPosition) : List<Cell>
    + GetCell(row, column) : Cell
    + GetCellAtMousePosition(mousePos) : Cell
    + SetCell(row, column, cell) : void
    + CombineGrids(otherGrids) : void
    + OnDrawGizmos() : void
}

class Cell {
    - row : int
    - column : int
    - state : CellState
    - occupant : IGridInteractable<T>
    - groundPrefab : GameObject

    + Cell(row, column)
    + GetState() : CellState
    + SetState(state) : void
    + GetOccupant() : IGridInteractable<T>
    + SetOccupant(occupant) : void
    + IsOccupied() : bool
    + GetNeighbors(grid) : List<Cell>
    + SaveCell() : void
    + LoadCell() : void
}

enum CellState {
    EMPTY
    OCCUPIED
}

interface IGridInteractable<T> {
    - isSelected : bool
    - isPlaced : bool

    + OnPlacedGridElement() : void
    + OnRemovedGridElement() : void
    + OnSelected() : void
    + PlaceOnGrid(grid, startingCell) : void
    + RemoveFromGrid() : void
    + GetOccupiedCells(grid, startingCell) : List<Cell>
    + IsSelected() : bool
    + IsPlaced() : bool
    + GetOccupantType() : T
}

Cell --> CellState : uses
Grid "1" -- "0..*" Cell : contains
Cell "0..*" -- "0..1" IGridInteractable : occupied by

@enduml
